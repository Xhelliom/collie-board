# Reference systemd --user unit. `scripts/collie-board-ctl.sh start` generates a copy of this with
# absolute paths filled in at ~/.config/systemd/user/collie.service. Edit + use this
# directly only if you prefer to manage it by hand.
#
#   cp systemd/collie-board.service ~/.config/systemd/user/
#   (edit the @PLACEHOLDERS@ below)
#   systemctl --user daemon-reload && systemctl --user enable --now collie

[Unit]
Description=Collie
After=default.target
# Never give up restarting — a phone-only operator can't run 'systemctl reset-failed'.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@PLUGIN_ROOT@
ExecStart=@BUN@ run @PLUGIN_ROOT@/bridge/index.ts
Restart=on-failure
RestartSec=5
# Hardening: the bridge is remote shell access, so deny privilege escalation. NO mount-namespace
# directive belongs here (PrivateTmp, ProtectSystem, PrivateDevices, ReadOnlyPaths…): a --user unit
# can only mount inside a USER namespace, where root-owned files read as nobody — which makes ssh
# refuse /etc/ssh/ssh_config.d/*, so every git push (Open a PR, Done) fails. See .adr/0008.
NoNewPrivileges=yes
Environment=HERDR_SOCKET_PATH=%h/.config/herdr/herdr.sock
Environment=COLLIE_BOARD_PORT=8788
Environment=HERDR_PLUGIN_CONFIG_DIR=%h/.config/collie-board
EnvironmentFile=-%h/.config/collie-board/.env

[Install]
WantedBy=default.target
