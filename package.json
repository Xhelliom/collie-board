{
  "name": "collie-board",
  "version": "0.22.0",
  "private": true,
  "license": "MIT",
  "description": "Collie Board — durable Kanban cards over your Herdr agent herd, served over Tailscale",
  "type": "module",
  "scripts": {
    "start": "bun run bridge/index.ts",
    "dev": "bun --watch bridge/index.ts",
    "build": "bun run typecheck && cd web && bun install && bun run typecheck && bun run build",
    "build:web": "cd web && bun run build",
    "web:dev": "cd web && bun run dev",
    "test": "bun test ./bridge && bash scripts/collie-board-ctl.test.sh",
    "test:ctl": "bash scripts/collie-board-ctl.test.sh",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "web-push": "^3.6.7"
  }
}
