# Third-party skills fetched into the checkout, and their lockfile. Someone else's repo, vendored
# for one operator's agent — not a dependency of the plugin, and untracked files are what put
# `-dirty` in every build stamp (vite.config.ts reads `git status --porcelain`).
.agents/
skills-lock.json

# Bug-repro screenshots — evidence for a fix, not documentation. Keep them local;
# the fix commit and its CHANGELOG line are the durable record.
.screenshot-bugs/
docs/bugs/
